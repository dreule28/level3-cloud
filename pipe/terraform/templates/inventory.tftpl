[control_plane]
%{ for name, host in control_plane ~}
${name} ansible_host=${host.ansible_host} k8s_ip=${host.k8s_ip}
%{ endfor ~}

[workers]
%{ for name, host in workers ~}
${name} ansible_host=${host.ansible_host} k8s_ip=${host.k8s_ip}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[all:vars]
ansible_user=${ansible_user}
ansible_ssh_private_key_file=${ansible_private_key_file}
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
